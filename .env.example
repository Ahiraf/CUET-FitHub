# Frontend build-time config (Vite). Copy to .env and adjust.
# Base URL of the CUET FitHub backend API.
VITE_API_URL=http://localhost:8080

# AI provider configuration (server-side only; never prefix these with VITE_).
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# OpenAI — last-resort fallback when all Gemini keys are exhausted.
OPENAI_API_KEY=
